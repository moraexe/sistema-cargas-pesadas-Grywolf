@page
@{
    ViewData["Title"] = "Cargas";
}

<h1 class="h3 mb-3">Cargas <small class="text-muted fs-6">servicios de transporte</small></h1>
<div id="mensajes"></div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h2 class="h5" id="tituloFormulario">Registrar carga</h2>
            <form id="formCarga" novalidate>
                <input type="hidden" id="cargaId" data-ignorar />
                <div class="mb-2">
                    <label class="form-label" for="codigo">Código</label>
                    <input class="form-control" id="codigo" name="codigo" maxlength="20" placeholder="CP-2026-0003" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="descripcion">Descripción</label>
                    <input class="form-control" id="descripcion" name="descripcion" maxlength="300" />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label" for="origen">Origen</label>
                        <input class="form-control" id="origen" name="origen" maxlength="100" placeholder="Bogotá" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="destino">Destino</label>
                        <input class="form-control" id="destino" name="destino" maxlength="100" placeholder="Medellín" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label" for="pesoTotalKg">Peso total (kg)</label>
                        <input class="form-control" id="pesoTotalKg" name="pesoTotalKg" data-tipo="numero" type="number" step="any" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="volumenTotalM3">Volumen (m³) <span class="opcional">opcional</span></label>
                        <input class="form-control" id="volumenTotalM3" name="volumenTotalM3" data-tipo="numero" type="number" step="any" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="tipoCargaId">Tipo de carga</label>
                    <select class="form-select" id="tipoCargaId" name="tipoCargaId" data-tipo="id"></select>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="tipoVehiculoId">Tipo de vehículo <span class="opcional">opcional</span></label>
                    <select class="form-select" id="tipoVehiculoId" name="tipoVehiculoId" data-tipo="id"></select>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="tipoEntregaId">Tipo de entrega</label>
                    <select class="form-select" id="tipoEntregaId" name="tipoEntregaId" data-tipo="id"></select>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="estadoId">Estado</label>
                    <select class="form-select" id="estadoId" name="estadoId" data-tipo="id"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="observaciones">Observaciones <span class="opcional">opcional</span></label>
                    <textarea class="form-control" id="observaciones" name="observaciones" rows="2" maxlength="500"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnGuardar">Registrar</button>
                    <button type="button" class="btn btn-outline-secondary d-none" id="btnCancelar">Cancelar edición</button>
                </div>
            </form>
        </div></div>
    </div>

    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">Cargas registradas</h2>
                <button class="btn btn-sm btn-outline-secondary" id="btnRecargar">Actualizar</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr><th>Código</th><th>Ruta</th><th class="text-end">Peso (kg)<br><small class="text-muted">objetos / declarado</small></th>
                            <th>Clasificación</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody id="tablaCargas"></tbody>
                </table>
            </div>
        </div></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/cargas.js" asp-append-version="true"></script>
}
