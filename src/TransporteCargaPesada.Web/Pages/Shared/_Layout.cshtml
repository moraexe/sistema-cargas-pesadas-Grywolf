<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Transporte de Carga Pesada</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TransporteCargaPesada.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index">Griwolf · Carga Pesada</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Cargas">Cargas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Objetos">Objetos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Categorias">Categorías</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Parametros">Parámetros</a></li>
                    </ul>
                    <span class="navbar-text small">Proyecto académico · Pruebas de software</span>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted small py-3">
        <div class="container">
            Empresa y datos ficticios. Los límites de peso y volumen son reglas académicas configurables, no límites legales.
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
