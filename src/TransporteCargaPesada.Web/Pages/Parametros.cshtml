@page
@{
    ViewData["Title"] = "Parámetros";
}

<h1 class="h3 mb-3">Parámetros <small class="text-muted fs-6">configuraciones con tipo de dato</small></h1>
<div id="mensajes"></div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h2 class="h5" id="tituloFormulario">Registrar parámetro</h2>
            <form id="formParametro" novalidate>
                <input type="hidden" id="parametroId" data-ignorar />
                <div class="mb-2">
                    <label class="form-label" for="codigo">Código</label>
                    <input class="form-control" id="codigo" name="codigo" maxlength="50" placeholder="CAPACIDAD_KG_CAMA_BAJA" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="nombre">Nombre</label>
                    <input class="form-control" id="nombre" name="nombre" maxlength="100" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="descripcion">Descripción <span class="opcional">opcional</span></label>
                    <textarea class="form-control" id="descripcion" name="descripcion" rows="2" maxlength="300"></textarea>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label" for="tipoDato">Tipo de dato</label>
                        <select class="form-select" id="tipoDato" name="tipoDato"></select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="unidadMedida">Unidad <span class="opcional">opcional</span></label>
                        <input class="form-control" id="unidadMedida" name="unidadMedida" maxlength="20" placeholder="kg" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="valor">Valor</label>
                    <input class="form-control" id="valor" name="valor" maxlength="200" />
                    <div class="form-text" id="ayudaTipo"></div>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="categoriaId">Categoría asociada <span class="opcional">opcional</span></label>
                    <select class="form-select" id="categoriaId" name="categoriaId" data-tipo="id"></select>
                </div>
                <div class="d-flex gap-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="esObligatorio" name="esObligatorio" data-tipo="bool" />
                        <label class="form-check-label" for="esObligatorio">Obligatorio</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="activo" name="activo" data-tipo="bool" checked />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnGuardar">Registrar</button>
                    <button type="button" class="btn btn-outline-secondary d-none" id="btnCancelar">Cancelar edición</button>
                </div>
            </form>
            <hr />
            <p class="small text-muted mb-0">
                <strong>General</strong>: sin categoría, aplica a todo el sistema. <strong>Por categoría</strong>: asociado a una
                categoría concreta. Los parámetros <strong>obligatorios</strong> no se eliminan ni se desactivan, y no cambian
                su código ni su tipo de dato. <code>CAPACIDAD_KG_*</code> debe asociarse a una categoría VEHICULO.
            </p>
        </div></div>
    </div>

    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">Parámetros registrados</h2>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" id="filtroCategoria" aria-label="Filtrar por categoría"></select>
                    <select class="form-select form-select-sm" id="filtroActivo" aria-label="Filtrar por estado">
                        <option value="">Todos</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead><tr><th>Código</th><th>Tipo</th><th class="text-end">Valor</th><th>Ámbito</th><th>Estado</th><th></th></tr></thead>
                    <tbody id="tablaParametros"></tbody>
                </table>
            </div>
        </div></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/parametros.js" asp-append-version="true"></script>
}
